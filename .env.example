# Copy this file to `.env.local` (git-ignored) and fill in the values.
# Restart `npm run dev` after changing it. On Vercel/Netlify, add the same
# variables in the project's Environment Variables settings.

# Your clinic's Google Place ID. Find it at:
# https://developers.google.com/maps/documentation/places/web-service/place-id
# Enables live reviews and the "Write a review" button.
VITE_GOOGLE_PLACE_ID=

# Google Maps browser API key with "Maps JavaScript API" and "Places API (New)" enabled.
# Restrict it to your website's domain (HTTP referrers) in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=
